<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>trap YOU little foe</title>
    <script>
        function openPopups() {
            // Specifications for each popup window
            const popupSpecs = [
                "width=300,height=200,left=100,top=100",
                "width=300,height=200,left=420,top=100",
                "width=300,height=200,left=740,top=100",
                "width=300,height=200,left=1060,top=100",
                "width=300,height=200,left=1380,top=100"
            ];

            // Open 5 popup windows with different content
            for (let i = 0; i < 5; i++) {
                let popup = window.open("", `popup${i+1}`, popupSpecs[i]);
                if (popup) {
                    popup.document.write(`
                        <html>
                        <head>
                            <title>Popup Window ${i + 1}</title>
                            <style>
                                body { font-family: Arial, sans-serif; text-align: center; margin-top: 50px; }
                                h2 { color: #2a9df4; }
                            </style>
                        </head>
                        <body>
                            <h2>Popup Window ${i + 1}</h2>
                            <p>This is popup window number ${i + 1}.</p>
                            <button onclick="window.close()">Close me</button>
                        </body>
                        </html>
                    `);
                    popup.document.close();
                } else {
                    alert("Popup blocked! Please allow popups for this site.");
                }
            }
        }
    </script>
</head>
<body>
    <h1>Popup Windows Example</h1>
    <p>Click the button to open 5 popup windows:</p>
    <button onclick="openPopups()">Open 5 Popups</button>
</body>
</html>
