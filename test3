<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Not a Trap</title>
</head>
<body>
  <button onclick="openPopupswithdelay(5, 500)">Do not click that thing</button>

  <script>
    function openPopupswithdelay(n, delay) {
      for (let i = 0; i < n; i++) {
    setTimeout((10000) => {  // Adjust number as needed
        window.open('https://www.youtube.com/watch?v=xvFZjo5PgG0', '_blank', 'width=4000,height=3000');
      }, i * delay);
    }
}
  </script>
</body>
</html>
